      "title": "六、备考建议",
      "blocks": [
        { "type": "subsection", "title": "1. 选择题备考" },
        {
          "type": "bullets",
          "items": [
            "熟记教材基本概念和观点",
            "关注年度重大时事（如科技成就、重大会议）",
            "注意审题，特别是「不正确的是」「错误的是」等反向设问"
          ]
        },
        { "type": "subsection", "title": "2. 主观题备考" },
        {
          "type": "bullets",
          "items": [
            "审题：明确设问角度（是什么/为什么/怎么做）",
            "联系教材：将材料与教材观点对应",
            "多角度作答：从道德、法律、国情等多角度分析",
            "规范表达：使用学科术语，条理清晰"
          ]
        },
        { "type": "subsection", "title": "3. 重点关注的主题" },
        {
          "type": "bullets",
          "items": [
            "社会主义核心价值观",
            "中华优秀传统文化",
            "科技创新与绿色发展",
            "公民权利与义务",
            "社会责任与担当"
          ]
        }
      ]
    },
    {
